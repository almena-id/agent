# Almena Agent configuration. `task init` copies this file to .env, which the
# agent (pydantic-settings), Docker Compose and Task all read.

# development | production | test. `production` hides /docs and /openapi.json.
AGENT_ENVIRONMENT=development
AGENT_LOG_LEVEL=INFO

# Port published on the host by Docker Compose (the agent listens on 8100 inside).
AGENT_PORT=8100

# Domain the agent is deployed at: the site and certificate of Caddy
# (Caddyfile, `task up`). Its DNS name must point at this machine. Docker
# Compose and Caddy read it; the agent itself does not.
AGENT_DOMAIN=agent.almena.id

# Cloudflare API token for Caddy's Let's Encrypt certificate (DNS-01): Zone /
# DNS / Edit on the domain's zone.
CLOUDFLARE_API_TOKEN=

# Public origin of the agent, https://{AGENT_DOMAIN} behind Caddy. The agent card (/.well-known/agent-card.json)
# advertises its A2A endpoints under it: {AGENT_PUBLIC_URL}/a2a/jsonrpc and
# {AGENT_PUBLIC_URL}/a2a/rest. For a local-only setup: http://localhost:8100
AGENT_PUBLIC_URL=https://agent.almena.id

# How the agent card names the agent and who runs it.
AGENT_NAME=Almena Agent
AGENT_DESCRIPTION=The AI agent of the Almena Network.
AGENT_PROVIDER_ORGANIZATION=Almena Network
AGENT_PROVIDER_URL=https://almena.id

# Claude. The Anthropic SDK reads the key itself; with it empty, `task dev`
# falls back to an `ant auth login` profile.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max: how hard Claude thinks, and so its cost.
AGENT_EFFORT=high
AGENT_MAX_TOKENS=64000
# Replaces the built-in system prompt (src/almena_agent/prompts.py) when set.
AGENT_SYSTEM_PROMPT=
# Exchanges a conversation (A2A context) holds before the peer must start a new one.
AGENT_HISTORY_TURNS=50
